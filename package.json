  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^10.14.0",
    "eslint-plugin-jsdoc": "^62.9.0",
    "playwright": "1.65.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@sentry/cli",
      "core-js",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ]
  },
  "license": "UNLICENSED",
