{
  "name": "lalista",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "VITEST_INTEGRATION=1 turbo run test:integration",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "db:reset": "curl -fsS -X POST http://supabase-runner:9000/db-reset",
    "db:status": "curl -fsS http://supabase-runner:9000/status",
    "db:start": "curl -fsS -X POST http://supabase-runner:9000/start",
    "db:stop": "curl -fsS -X POST http://supabase-runner:9000/stop",
    "db:gen-types": "curl -fsS http://supabase-runner:9000/gen-types -o packages/core/src/supabase.types.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-plugin-jsdoc": "^65.4.2",
    "husky": "^9.0.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "turbo": "^2.9.6",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.59.1",
    "vercel": "^53.0.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@sentry/cli",
      "core-js",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ]
  },
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0"
}
