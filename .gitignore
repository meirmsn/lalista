.env
# Next.js local env overrides — per-workspace derivatives of .devcontainer/.env
# See /devshop/.claude/skills/ak-new-project/SKILL.md § Step 13b
.env.local
.env.*.local

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
/build/
.next/
*.tsbuildinfo

# Playwright
playwright-report/
test-results/

# Turbo
.turbo/

# Next.js telemetry
**/cache/config.json

# Logs
*.log

.devshopkit
.claude/*
!.claude/memory/
.dcg.toml
.hooks/


# gstack runtime state — only .md artifacts (design docs, plans) under projects/ are version-tracked.
# Verbose because gitignore re-includes don't reach into excluded directories — must re-include each level.
.gstack/*
!.gstack/projects/
.gstack/projects/*
!.gstack/projects/*/
.gstack/projects/*/*
!.gstack/projects/*/*.md

# OS
.DS_Store
.vercel

# Screenshots convention — /screenshots/ is for dev-context shots you
# share with Claude / the team. Folder contents are ignored; only the
# README is tracked so a fresh clone discovers the convention.
# Per-feature product shots still live in specs/<feature>/hero/ (tracked).
/screenshots/*
!/screenshots/README.md
# macOS drops screenshots at repo root by default — ignore those too.
/Screenshot*.png

# Pre-ship evidence screenshots (regenerable, per-gate evidence).
# Hero screenshots (durable, for PR description + BUILD-LOG.md) are committed
# separately — see /devshop roadmap § "screenshot convention".
specs/*/screenshots/

# Per-session handoff docs (transient, generated by /ak-handoff for context-continuation)
.handoff/
